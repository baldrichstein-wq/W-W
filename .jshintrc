    "alert": true,
    "confirm": true,
    "prompt": true,
    "require": true,
    "module": true,
    "exports": true,
    "Promise": true,
    "Set": true,
    "Map": true,
    "Object": true,
    "Array": true,
    "String": true,
    "Number": true,
    "Boolean": true,
    "JSON": true,
    "Error": true,
    "parseInt": true,
    "parseFloat": true,
    "isNaN": true,
    "isFinite": true,
    "decodeURIComponent": true,
    "encodeURIComponent": true,
    "fetch": true,
